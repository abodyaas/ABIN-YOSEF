<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>مكتب يوسف مطهر للسفريات | حجوزات فخمة وخدمة موثوقة</title>
  <meta name="description" content="مكتب يوسف مطهر للسفريات - حجوزات طيران، تأشيرات، فنادق، رحلات سياحية، حج وعمرة، ودعوات سفر بخدمة راقية وسريعة." />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg:#060914;
      --bg2:#0a1020;
      --bg3:#0d1630;
      --card:rgba(255,255,255,.06);
      --card2:rgba(255,255,255,.04);
      --stroke:rgba(255,255,255,.12);
      --text:rgba(255,255,255,.94);
      --muted:rgba(255,255,255,.72);
      --muted2:rgba(255,255,255,.56);
      --gold:#D4AF37;
      --gold2:#f7d978;
      --green:#25D366;
      --shadow:0 20px 60px rgba(0,0,0,.45);
      --shadow2:0 30px 100px rgba(0,0,0,.55);
      --radius:20px;
      --radius2:28px;
      --radius3:34px;
      --speed:320ms;
      --blur:14px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      font-family:"Cairo", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      color:var(--text);
      overflow-x:hidden;
      background:
        radial-gradient(800px 500px at 15% 10%, rgba(212,175,55,.15), transparent 60%),
        radial-gradient(900px 550px at 85% 12%, rgba(212,175,55,.10), transparent 60%),
        radial-gradient(700px 380px at 50% 45%, rgba(57,75,128,.18), transparent 60%),
        linear-gradient(180deg, #05070f 0%, #07101f 35%, #081121 65%, #050811 100%);
      min-height:100vh;
    }

    body::before{
      content:"";
      position:fixed;
      inset:0;
      pointer-events:none;
      background:
        linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
      background-size:36px 36px;
      mask-image:radial-gradient(circle at center, rgba(0,0,0,.7), transparent 85%);
      opacity:.22;
      z-index:0;
    }

    ::selection{
      background:rgba(212,175,55,.28);
      color:#fff;
    }

    a, button, input, textarea{font-family:inherit}

    .container{width:min(1240px, 92%); margin-inline:auto; position:relative; z-index:2}
    .grid{display:grid; gap:20px}
    .muted{color:var(--muted)}
    .gold{color:var(--gold)}
    .section{padding:95px 0}
    .section-head{
      display:flex;
      align-items:end;
      justify-content:space-between;
      gap:16px;
      flex-wrap:wrap;
      margin-bottom:28px;
    }
    .eyebrow{
      display:inline-flex;
      align-items:center;
      gap:10px;
      padding:10px 16px;
      border-radius:999px;
      background:rgba(255,255,255,.05);
      border:1px solid rgba(255,255,255,.09);
      color:var(--muted);
      backdrop-filter:blur(12px);
      -webkit-backdrop-filter:blur(12px);
      margin-bottom:14px;
    }
    .section h2{
      margin:0 0 10px;
      font-size:clamp(28px, 4vw, 44px);
      line-height:1.15;
      letter-spacing:.2px;
    }
    .section p.lead{
      margin:0;
      color:var(--muted);
      line-height:1.95;
      font-size:clamp(14px,1.5vw,18px);
      max-width:820px;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      border:none;
      cursor:pointer;
      text-decoration:none;
      padding:15px 22px;
      border-radius:999px;
      color:#fff;
      font-weight:800;
      letter-spacing:.2px;
      position:relative;
      overflow:hidden;
      transition:transform var(--speed) ease, box-shadow var(--speed) ease, border-color var(--speed) ease, background var(--speed) ease;
      background:linear-gradient(180deg, rgba(212,175,55,.30), rgba(212,175,55,.15));
      border:1px solid rgba(212,175,55,.55);
      box-shadow:0 14px 40px rgba(212,175,55,.16);
      white-space:nowrap;
    }
    .btn::before{
      content:"";
      position:absolute;
      inset:-120% auto auto -30%;
      width:40%;
      height:260%;
      transform:rotate(22deg);
      background:linear-gradient(90deg, transparent, rgba(255,255,255,.22), transparent);
      transition:transform 700ms ease;
    }
    .btn:hover{
      transform:translateY(-3px);
      box-shadow:0 20px 60px rgba(212,175,55,.22);
      border-color:rgba(212,175,55,.9);
    }
    .btn:hover::before{
      transform:translate(260%,0) rotate(22deg);
    }

    .btn.secondary{
      background:rgba(255,255,255,.05);
      border:1px solid rgba(255,255,255,.12);
      box-shadow:none;
    }
    .btn.secondary:hover{
      border-color:rgba(212,175,55,.55);
      box-shadow:0 18px 50px rgba(0,0,0,.28);
    }

    .btn.dark{
      background:linear-gradient(180deg, rgba(0,0,0,.28), rgba(255,255,255,.04));
      border:1px solid rgba(255,255,255,.14);
    }

    .chip{
      display:inline-flex;
      align-items:center;
      gap:10px;
      padding:10px 14px;
      border-radius:999px;
      background:rgba(255,255,255,.05);
      border:1px solid rgba(255,255,255,.10);
      color:var(--muted);
      backdrop-filter:blur(10px);
      -webkit-backdrop-filter:blur(10px);
      transition:transform var(--speed) ease, border-color var(--speed) ease, background var(--speed) ease;
    }
    .chip:hover{
      transform:translateY(-2px);
      border-color:rgba(212,175,55,.55);
      background:rgba(255,255,255,.065);
    }

    .progress{
      position:fixed;
      top:0;
      right:0;
      height:3px;
      width:0%;
      z-index:99999;
      background:linear-gradient(90deg, var(--gold), #fff2b2, var(--gold2));
      box-shadow:0 0 18px rgba(212,175,55,.45);
      transition:width .1s linear;
    }

    .orb{
      position:absolute;
      border-radius:50%;
      filter:blur(60px);
      opacity:.35;
      pointer-events:none;
      z-index:1;
    }
    .orb.one{
      width:260px; height:260px;
      top:120px; right:-60px;
      background:rgba(212,175,55,.24);
      animation:floatY 8s ease-in-out infinite;
    }
    .orb.two{
      width:220px; height:220px;
      left:-70px; top:460px;
      background:rgba(84,124,255,.18);
      animation:floatY 10s ease-in-out infinite reverse;
    }
    .orb.three{
      width:260px; height:260px;
      left:35%; top:1300px;
      background:rgba(212,175,55,.15);
      animation:floatY 12s ease-in-out infinite;
    }

    @keyframes floatY{
      0%,100%{transform:translateY(0)}
      50%{transform:translateY(-26px)}
    }

    .topbar{
      position:relative;
      z-index:10;
      padding:11px 0;
      border-bottom:1px solid rgba(255,255,255,.08);
      background:rgba(0,0,0,.16);
      backdrop-filter:blur(10px);
      -webkit-backdrop-filter:blur(10px);
    }
    .topbar .row{
      display:flex;
      gap:14px;
      align-items:center;
      justify-content:space-between;
      flex-wrap:wrap;
      color:var(--muted);
      font-size:14px;
    }
    .topbar .mini{
      display:flex;
      align-items:center;
      gap:10px;
      flex-wrap:wrap;
    }
    .topbar strong{color:#fff}

    .nav{
      position:sticky;
      top:0;
      z-index:1000;
      background:rgba(6,9,20,.58);
      backdrop-filter:blur(16px);
      -webkit-backdrop-filter:blur(16px);
      border-bottom:1px solid rgba(255,255,255,.08);
    }
    .nav.scrolled{
      background:rgba(5,8,16,.82);
      box-shadow:0 12px 40px rgba(0,0,0,.28);
    }
    .nav .inner{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:14px;
      padding:14px 0;
    }
    .brand{
      display:flex;
      align-items:center;
      gap:13px;
      text-decoration:none;
      color:#fff;
      min-width:0;
    }
    .logo{
      width:48px;
      height:48px;
      border-radius:16px;
      display:grid;
      place-items:center;
      flex:0 0 auto;
      background:
        radial-gradient(18px 18px at 32% 28%, rgba(255,255,255,.28), transparent 60%),
        linear-gradient(180deg, rgba(212,175,55,.38), rgba(212,175,55,.11));
      border:1px solid rgba(212,175,55,.48);
      box-shadow:0 16px 42px rgba(212,175,55,.18);
    }
    .logo svg{opacity:.96}
    .brand .name{
      display:flex;
      flex-direction:column;
      line-height:1.1;
      min-width:0;
    }
    .brand .name b{
      font-size:17px;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }
    .brand .name span{
      font-size:12px;
      color:var(--muted);
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .navlinks{
      display:flex;
      align-items:center;
      gap:6px;
      flex-wrap:wrap;
    }
    .navlinks a{
      text-decoration:none;
      color:var(--muted);
      padding:11px 14px;
      border-radius:14px;
      transition:transform var(--speed) ease, background var(--speed) ease, color var(--speed) ease, border-color var(--speed) ease;
      font-weight:700;
      border:1px solid transparent;
    }
    .navlinks a:hover,
    .navlinks a.active{
      color:#fff;
      background:rgba(255,255,255,.05);
      border-color:rgba(255,255,255,.07);
      transform:translateY(-1px);
    }

    .navactions{
      display:flex;
      align-items:center;
      gap:10px;
    }

    .menu-btn{
      display:none;
      width:46px;
      height:46px;
      border-radius:14px;
      border:1px solid rgba(255,255,255,.10);
      background:rgba(255,255,255,.05);
      color:#fff;
      font-size:20px;
      cursor:pointer;
    }

    .mobile-menu{
      display:none;
      padding:0 0 14px;
    }
    .mobile-panel{
      border-radius:22px;
      padding:12px;
      background:linear-gradient(180deg, rgba(255,255,255,.07), rgba(255,255,255,.04));
      border:1px solid rgba(255,255,255,.10);
      box-shadow:var(--shadow);
    }
    .mobile-panel a{
      display:block;
      text-decoration:none;
      color:#fff;
      padding:14px 12px;
      border-radius:14px;
      font-weight:700;
      transition:background var(--speed) ease, transform var(--speed) ease;
    }
    .mobile-panel a:hover{
      background:rgba(255,255,255,.06);
      transform:translateX(-2px);
    }

    .hero{
      position:relative;
      padding:62px 0 36px;
      overflow:hidden;
    }

    .hero-grid{
      display:grid;
      grid-template-columns:1.08fr .92fr;
      gap:24px;
      align-items:stretch;
    }

    .hero h1{
      margin:0 0 16px;
      font-size:clamp(36px, 5vw, 64px);
      line-height:1.08;
      letter-spacing:.2px;
    }
    .hero .sub{
      margin:0 0 24px;
      color:var(--muted);
      line-height:2;
      font-size:clamp(15px, 1.5vw, 19px);
      max-width:720px;
    }
    .hero .cta{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
      margin:20px 0 18px;
    }
    .hero .trust{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      margin-top:14px;
    }

    .hero-stats{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:14px;
      margin-top:22px;
    }
    .stat{
      padding:18px 16px;
      border-radius:22px;
      background:linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
      border:1px solid rgba(255,255,255,.10);
      box-shadow:0 16px 50px rgba(0,0,0,.25);
      position:relative;
      overflow:hidden;
    }
    .stat::before{
      content:"";
      position:absolute;
      inset:auto -20% -55% auto;
      width:160px;
      height:160px;
      border-radius:50%;
      background:radial-gradient(circle, rgba(212,175,55,.18), transparent 65%);
      pointer-events:none;
    }
    .stat b{
      display:block;
      font-size:28px;
      margin-bottom:6px;
      color:#fff;
    }
    .stat span{
      color:var(--muted);
      font-size:14px;
      line-height:1.8;
    }

    .hero-card{
      position:relative;
      border-radius:var(--radius3);
      overflow:hidden;
      background:linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.03));
      border:1px solid rgba(255,255,255,.10);
      box-shadow:var(--shadow2);
      isolation:isolate;
    }
    .hero-card::before{
      content:"";
      position:absolute;
      inset:-1px;
      background:
        radial-gradient(420px 220px at 74% 16%, rgba(212,175,55,.26), transparent 56%),
        radial-gradient(380px 200px at 20% 80%, rgba(61,92,166,.16), transparent 55%);
      z-index:-1;
      pointer-events:none;
    }

    .hero-media{
      position:relative;
      height:260px;
      overflow:hidden;
      border-bottom:1px solid rgba(255,255,255,.08);
      background:
        linear-gradient(180deg, rgba(0,0,0,.10), rgba(0,0,0,.55)),
        url("https://images.unsplash.com/photo-1436491865332-7a61a109cc05?auto=format&fit=crop&w=1400&q=80");
      background-size:cover;
      background-position:center;
    }
    .hero-media::after{
      content:"";
      position:absolute;
      inset:0;
      background:linear-gradient(180deg, rgba(0,0,0,.0), rgba(0,0,0,.35));
    }

    .hero-badge{
      position:absolute;
      top:18px;
      right:18px;
      z-index:2;
      padding:10px 14px;
      border-radius:999px;
      background:rgba(0,0,0,.35);
      border:1px solid rgba(255,255,255,.16);
      backdrop-filter:blur(10px);
      -webkit-backdrop-filter:blur(10px);
      color:#fff;
      font-size:13px;
      font-weight:800;
    }

    .floating-card{
      position:absolute;
      left:18px;
      bottom:18px;
      z-index:2;
      width:min(260px, calc(100% - 36px));
      padding:14px;
      border-radius:20px;
      background:rgba(7,12,24,.72);
      border:1px solid rgba(255,255,255,.14);
      backdrop-filter:blur(12px);
      -webkit-backdrop-filter:blur(12px);
      box-shadow:0 18px 50px rgba(0,0,0,.32);
    }
    .floating-card b{
      display:block;
      margin-bottom:6px;
    }
    .floating-card span{
      color:var(--muted);
      font-size:13px;
      line-height:1.8;
    }

    .hero-content{
      padding:22px;
    }
    .hero-content h3{
      margin:0 0 8px;
      font-size:22px;
    }
    .hero-content p{
      margin:0 0 16px;
      color:var(--muted);
      line-height:1.95;
    }

    .check-list{
      display:grid;
      gap:10px;
      margin-top:8px;
    }
    .check{
      display:flex;
      align-items:flex-start;
      gap:10px;
      padding:12px 14px;
      border-radius:16px;
      background:rgba(0,0,0,.16);
      border:1px solid rgba(255,255,255,.09);
    }
    .check i{
      font-style:normal;
      color:var(--gold2);
      margin-top:1px;
    }
    .check span{
      color:var(--muted);
      line-height:1.8;
      font-size:14px;
    }

    .strip{
      margin-top:20px;
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:12px;
      padding:14px;
      border-radius:22px;
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.10);
    }
    .strip .item{
      padding:14px;
      border-radius:18px;
      background:rgba(0,0,0,.14);
      border:1px solid rgba(255,255,255,.08);
      transition:transform var(--speed) ease, border-color var(--speed) ease;
    }
    .strip .item:hover{
      transform:translateY(-3px);
      border-color:rgba(212,175,55,.55);
    }
    .strip b{
      display:block;
      margin-bottom:8px;
      font-size:15px;
    }
    .strip span{
      color:var(--muted);
      font-size:13px;
      line-height:1.8;
    }

    .cards{
      grid-template-columns:repeat(4,1fr);
    }
    .card{
      position:relative;
      overflow:hidden;
      border-radius:24px;
      padding:22px;
      background:linear-gradient(180deg, rgba(255,255,255,.07), rgba(255,255,255,.03));
      border:1px solid rgba(255,255,255,.10);
      box-shadow:0 20px 60px rgba(0,0,0,.28);
      transition:transform var(--speed) ease, border-color var(--speed) ease, box-shadow var(--speed) ease;
      isolation:isolate;
    }
    .card::before{
      content:"";
      position:absolute;
      inset:-2px;
      background:radial-gradient(260px 180px at 18% 8%, rgba(212,175,55,.22), transparent 54%);
      opacity:.85;
      z-index:-1;
      pointer-events:none;
    }
    .card:hover{
      transform:translateY(-6px);
      border-color:rgba(212,175,55,.60);
      box-shadow:0 30px 90px rgba(0,0,0,.35);
    }

    .icon{
      width:52px;
      height:52px;
      border-radius:18px;
      display:grid;
      place-items:center;
      background:rgba(212,175,55,.14);
      border:1px solid rgba(212,175,55,.38);
      box-shadow:0 10px 26px rgba(212,175,55,.10);
      margin-bottom:14px;
      font-size:22px;
    }
    .card h4{
      margin:0 0 8px;
      font-size:20px;
    }
    .card p{
      margin:0 0 14px;
      color:var(--muted);
      line-height:1.95;
      font-size:14px;
    }
    .card small{
      display:block;
      color:var(--gold2);
      font-weight:700;
      opacity:.92;
    }

    .offers{
      grid-template-columns:1.05fr .95fr;
      align-items:stretch;
    }
    .offer-box{
      position:relative;
      padding:24px;
      border-radius:26px;
      background:
        radial-gradient(420px 260px at 18% 8%, rgba(212,175,55,.17), transparent 54%),
        linear-gradient(180deg, rgba(255,255,255,.07), rgba(255,255,255,.04));
      border:1px solid rgba(255,255,255,.10);
      box-shadow:var(--shadow);
      overflow:hidden;
    }
    .offer-box .row{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:16px;
      flex-wrap:wrap;
    }
    .offer{
      margin-top:18px;
      display:grid;
      gap:12px;
    }
    .offer .o{
      padding:16px;
      border-radius:20px;
      background:rgba(0,0,0,.16);
      border:1px solid rgba(255,255,255,.09);
      transition:transform var(--speed) ease, border-color var(--speed) ease, background var(--speed) ease;
    }
    .offer .o:hover{
      transform:translateY(-3px);
      border-color:rgba(212,175,55,.55);
      background:rgba(255,255,255,.04);
    }
    .o b{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin-bottom:6px;
      font-size:16px;
    }
    .o p{
      margin:0;
      color:var(--muted);
      line-height:1.9;
      font-size:14px;
    }
    .badge{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:6px 10px;
      border-radius:999px;
      background:rgba(212,175,55,.12);
      border:1px solid rgba(212,175,55,.46);
      color:var(--gold2);
      font-size:12px;
      font-weight:800;
      white-space:nowrap;
    }

    .promise{
      display:grid;
      gap:12px;
      margin-top:18px;
    }
    .promise-item{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding:16px;
      border-radius:18px;
      background:rgba(0,0,0,.16);
      border:1px solid rgba(255,255,255,.10);
      transition:transform var(--speed) ease, border-color var(--speed) ease;
    }
    .promise-item:hover{
      transform:translateY(-2px);
      border-color:rgba(212,175,55,.55);
    }
    .promise-item b{display:block}
    .promise-item span{
      color:var(--muted);
      font-size:14px;
      line-height:1.8;
    }

    .visa-grid{
      grid-template-columns:repeat(2,1fr);
    }
    .visa-card{
      position:relative;
      border-radius:26px;
      overflow:hidden;
      padding:22px;
      background:linear-gradient(180deg, rgba(255,255,255,.07), rgba(255,255,255,.03));
      border:1px solid rgba(255,255,255,.10);
      box-shadow:0 20px 70px rgba(0,0,0,.32);
      transition:transform var(--speed) ease, border-color var(--speed) ease, box-shadow var(--speed) ease;
    }
    .visa-card:hover{
      transform:translateY(-5px);
      border-color:rgba(212,175,55,.55);
      box-shadow:0 28px 90px rgba(0,0,0,.38);
    }
    .visa-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:14px;
      margin-bottom:14px;
      flex-wrap:wrap;
    }
    .visa-top h3{
      margin:0;
      font-size:24px;
